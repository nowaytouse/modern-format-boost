# Modern Format Boost - direnv configuration
# Automatically activates virtual environment and Rust build optimizations

# =============================================================================
# Python 虚拟环境
# =============================================================================
if [[ -f .venv/bin/activate ]]; then
    source .venv/bin/activate
elif [[ -f scripts/venv/bin/activate ]]; then
    source scripts/venv/bin/activate
else
    # Only warn if in an interactive shell to avoid noise in scripts
    if [[ $- == *i* ]]; then
        echo "⚠️  Virtual environment (.venv) not found. Run 'python3 -m venv .venv && source .venv/bin/activate && pip install -r scripts/requirements.txt' to set up."
    fi
fi

# =============================================================================
# Rust 编译优化环境变量
# =============================================================================

# 并行编译数（默认使用所有 CPU 核心）
# 如果内存不足，可以减少为 CARGO_BUILD_JOBS=4
export CARGO_BUILD_JOBS=$(sysctl -n hw.ncpu)

# 启用 cargo-nextest 作为测试运行器（如果安装）
if command -v cargo-nextest &> /dev/null; then
    export CARGO_TEST_COMMAND="nextest run"
fi

# RUSTFLAGS 额外优化（补充 .cargo/config.toml）
# 注意：target-cpu=native 会导致二进制不可移植，仅用于开发
# export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=native"

# =============================================================================
# 开发工具别名
# =============================================================================
alias cb="cargo build"
alias cbf="cargo build --profile dev-fast"
alias cbr="cargo build --release"
alias cc="cargo check"
alias ct="cargo test"
alias ctf="cargo nextest run 2>/dev/null || cargo test"
alias cf="cargo fmt"
alias cl="cargo clippy"
