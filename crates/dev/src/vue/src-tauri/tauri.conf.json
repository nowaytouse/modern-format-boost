{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFB_UI1",
  "version": "0.1.0",
  "identifier": "com.nyamiiko.mfbui1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modern Format Boost",
        "width": 1100,
        "height": 680,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost asset:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: tauri: data:; connect-src 'self' ipc: http://ipc.localhost ws:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
