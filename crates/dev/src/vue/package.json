{
  "name": "mfb_launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:tsc": "vue-tsc --noEmit --strict",
    "lint": "npm run lint:oxlint && npm run lint:eslint && npm run lint:tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "env npm_config_allow_scripts= npm_config_registry=https://registry.npmjs.org npm ci --ignore-scripts --dry-run && env npm_config_allow_scripts= npm_config_registry=https://registry.npmjs.org npm audit --audit-level=high",
    "deps:update": "npm update --package-lock-only"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^68.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
