#!/bin/zsh
# Modern Format Boost - macOS App Wrapper
#
# Entry point using zsh (system default shell); supports drag-and-drop or double-click folder selection

# Get app bundle path (zsh: $0 is script path)
APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
PROJECT_ROOT="$(dirname "$APP_DIR")"
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
PROCESSOR_SCRIPT="$PROJECT_ROOT/scripts/drag_and_drop_processor.py"

contains_control_chars() {
    # Strictly check for Newline (\012) and Carriage Return (\015) using octal literals.
    [[ "$1" == *$'\012'* || "$1" == *$'\015'* ]]
}

choose_processing_mode() {
    osascript <<EOF
    set theOptions to {"🖼️ Only Static Images", "🎬 Only Animated/Videos", "🔄 Process Everything"}
    set choice to (choose from list theOptions with title "Modern Format Boost" with prompt "Select processing scope:" default items {"🔄 Process Everything"} without empty selection allowed)
    if choice is false then
        return "CANCEL"
    else
        return item 1 of choice
    end if
EOF
}

shell_quote() {
    # Safer quoting for Chinese paths: wrap in single quotes and escape any single quotes within the path
    echo "'${1//\'/\'\\\'\'}'"
}

escape_applescript_string() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    printf '%s' "$value"
}

launch_in_terminal() {
    local target_path="$1"
    local mode_flag="$2"
    local keep_open="${3:-false}"
    # Construct command with virtual environment support
    local cmd="cd $(shell_quote "$PROJECT_ROOT")"
    cmd+=" && if [[ -f .venv/bin/activate ]]; then source .venv/bin/activate; fi"
    cmd+=" && export FROM_APP=1 && $(shell_quote "$PROCESSOR_SCRIPT") $mode_flag"

    if [[ -n "$target_path" ]]; then
        if contains_control_chars "$target_path"; then
            osascript -e 'display alert "Invalid Path" message "Selected path contains unsupported control characters." as critical'
            return 1
        fi
        cmd+=" $(shell_quote "$target_path")"
    fi

    if [[ "$keep_open" == "true" ]]; then
        cmd+="; echo 'Press any key to close...'; read -n 1"
    fi

    local escaped_cmd
    escaped_cmd=$(escape_applescript_string "$cmd")

    osascript <<EOF
tell application "Terminal"
    set new_tab to do script "$escaped_cmd"
    set number of columns of new_tab to 223
    set number of rows of new_tab to 45
    activate
end tell
EOF
}

# Check if processor script exists
if [[ ! -f "$PROCESSOR_SCRIPT" ]]; then
    osascript -e 'display alert "Error" message "Processor script not found. Please ensure Modern Format Boost is fully installed." as critical'
    exit 1
fi

# Get processing mode once
MODE=$(choose_processing_mode)
if [[ "$MODE" == "CANCEL" ]]; then
    exit 0
fi

MODE_FLAG=""
if [[ "$MODE" == *"Images"* ]]; then
    MODE_FLAG="--images-only"
elif [[ "$MODE" == *"Videos"* ]]; then
    MODE_FLAG="--videos-only"
fi

# If arguments provided (drag mode), run processor in new Terminal window; this script exits to avoid empty window
if [[ $# -gt 0 ]]; then
    (
        launch_in_terminal "$1" "$MODE_FLAG" "true"
    ) &
    exit 0
else
    # Double-click mode: folder selection with 30-minute timeout
    TIMEOUT_SEC=1800
    TMPOUT=$(mktemp 2>/dev/null || echo "/tmp/mfb_choose_$$.txt")
    osascript -e 'POSIX path of (choose folder with prompt "Select folder to process (30-minute timeout):")' > "$TMPOUT" 2>/dev/null &
    OPID=$!
    for ((i = 0; i < TIMEOUT_SEC; i++)); do
        if ! kill -0 "$OPID" 2>/dev/null; then
            break
        fi
        sleep 1
    done
    if kill -0 "$OPID" 2>/dev/null; then
        kill "$OPID" 2>/dev/null
        wait "$OPID" 2>/dev/null
        rm -f "$TMPOUT"
        osascript -e 'display alert "Timeout" message "Folder selection cancelled (no action for 30 minutes)." as critical'
        exit 0
    fi
    SELECTED_DIR=$(cat "$TMPOUT" 2>/dev/null)
    rm -f "$TMPOUT"
    if [[ -z "$SELECTED_DIR" ]]; then
        exit 0
    fi
    SELECTED_DIR="${SELECTED_DIR%/}"
    if contains_control_chars "$SELECTED_DIR"; then
        osascript -e 'display alert "Invalid Path" message "Selected path contains unsupported control characters." as critical'
        exit 1
    fi

    # Directly launch terminal without redundant confirmation popups
    launch_in_terminal "$SELECTED_DIR" "$MODE_FLAG"
    exit 0
fi
